# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Local presentation drafts; only the finalized v4 deck is committed.
/.presentation-output/Foundry-Frontier-발표자료.pptx
/.presentation-output/Foundry-Frontier-개발과정-발표자료.pptx
/.presentation-output/Foundry-Frontier-개발과정-발표자료-v2.pptx
/.presentation-output/Foundry-Frontier-개발과정-발표자료-v3.pptx
